{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "rm -f prototype/plan.md && cp docs/PRODUCTION_PLAN.md prototype/plan.md && cp marketing/new-full-walkthrough.mp4 prototype/video/walkthrough.mp4",
  "installCommand": "",
  "outputDirectory": "prototype",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
